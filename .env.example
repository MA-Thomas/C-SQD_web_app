DATABASE_URL=postgres://csqd:csqd@localhost:55432/csqd
CSQD_API_PORT=8080
# Bind address for the API. Loopback for local dev; 0.0.0.0 in containers.
CSQD_API_BIND=127.0.0.1
CSQD_WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
CSQD_CONTACT_EMAIL=admin@csqd.local

# Base URL of the web app; used to build magic sign-in links.
CSQD_WEB_BASE_URL=http://localhost:3000

# Dev-auth mode: when enabled (the local default), magic sign-in links are
# returned in the API response instead of being emailed. MUST be 0 in any
# deployment other people can reach — otherwise anyone can sign in as any
# email address. With dev auth off, links are only written to the API log
# until a transactional email provider is wired up.
CSQD_DEV_AUTH=1

# Set the Secure attribute on session cookies. Enable (1) in any HTTPS
# deployment; leave 0 only for local plain-HTTP development.
CSQD_SECURE_COOKIES=0

# Transactional email. With no provider configured, outbound mail (magic
# links, inquiry notifications, solicitation notices) is logged instead of
# sent. Providers supported directly: resend, postmark.
# CSQD_EMAIL_PROVIDER=resend
# CSQD_EMAIL_API_KEY=
# CSQD_EMAIL_FROM="C-SQD <audits@example.org>"

# Show the "demonstration data" banner on all public pages. Enable in any
# environment where seed data is loaded and outsiders might browse.
# NEXT_PUBLIC_DEMO_MODE=1
